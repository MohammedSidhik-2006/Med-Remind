# Server configuration
PORT=5000
NODE_ENV=development
TZ=Asia/Kolkata
ALLOWED_ORIGINS=http://localhost:3000

# Database
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/medremind?retryWrites=true&w=majority

# JWT details
JWT_SECRET=replace-with-64-char-random-string

# VAPID keys for push notifications
VAPID_PUBLIC_KEY=replace-with-generated-vapid-public-key
VAPID_PRIVATE_KEY=replace-with-generated-vapid-private-key
VAPID_EMAIL=mailto:admin@medremind.com

# OPTION A: Email SMTP configuration (Recommended for production)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
SMTP_FROM="MedRemind Support" <support@medremind.com>

# OPTION B: Gmail app password or general email service fallback
EMAIL_SERVICE=gmail
EMAIL_USER=your_gmail@gmail.com
EMAIL_PASS=your-16-char-app-password
